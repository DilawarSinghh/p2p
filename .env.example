# ============================================================================
# Predictive Circular-Resource Grid - Environment Variables
# ============================================================================
# Copy this file to `.env.local` and fill in your Supabase project values.
# In the Supabase dashboard: Project Settings -> API
# ============================================================================

# --- Supabase: client-safe (exposed to the browser) ---
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> Project API keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase: server-only (NEVER expose to the browser) ---
# Project Settings -> API -> Project API keys -> service_role (secret)
# Used only by server-side seeding / admin routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Direct Postgres connection (optional, for CLI seeding/migrations) ---
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- App behaviour ---
# When "true", the app reads bundled local JSON datasets instead of Supabase.
# Set to "false" once your Supabase project is seeded and reachable.
NEXT_PUBLIC_USE_LOCAL_DATA=true

